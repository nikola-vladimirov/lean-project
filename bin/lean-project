#!/usr/bin/env bash
# lean-project: read less, pay less. Maps and contents tables so Claude opens only the lines it needs,
# and a cost report of what a session pays before doing any work. Bash + POSIX awk only.
#
#   lean-project map <file>              outline with line ranges (markdown headings, code symbols)
#   lean-project map <dir> [min_lines]   files at or over min_lines (default 300): map those before reading
#   lean-project map predict <file>      files that changed with <file> in the last 10 commits, with their maps
#   lean-project toc <file>... [--force] build or refresh a "<!-- toc -->" table inside markdown docs
#   lean-project cost [dir]              auto-loaded files, startup baseline, every doc with flags, duplicated lines
#   lean-project board [id]              shared task board (all cards, or one card's history)
#   lean-project board add|move|note|files <id> ...   add <id> <title> | move <id> todo|doing|blocked|done [why] | note <id> <text> | files <id> <paths>
#   lean-project check gate <id> [files...]   php syntax and WordPress standards on a card's files; failure sends the card back to todo
#   lean-project audit waste [dir] [--apply]  comment blocks, debug logs, repeated hooks; dry run unless --apply
#   lean-project frontier [docs/PLAN.md]      decisions to ask now (open, prerequisites decided) and what waits on them
#   lean-project lesson "<text>" [--project P] [--mode M]   record a lesson; a second sighting becomes a local rule
#   lean-project lessons                      the local rules and the lessons file
#   lean-project audit security [dir or files...]  WordPress anti-patterns in PHP and JS (unescaped output, unprepared SQL, missing nonce or capability checks); files = edited files only
#   lean-project handoff [docs/PLAN.md]  draft of the state file: branch, next tasks, cards in flight (prints only)
#   lean-project delegate config | set <key> <value> | check | run <brief> <output>   route bulk work to the project's runner (none, llama, opencode)
#   lean-project audit perf [dir or files...]  performance and HPOS scan of WordPress and WooCommerce code (wp-woo-performance-audit skill); files = edited files only
#   lean-project selftest                check the tool on this machine
set -u

TOC_MIN=80        # below this a table costs more than it saves
HANDOFF_MAX=60
NOTE='Contents table below: open only the section you need.'
# Folders never worth scanning: VCS, dependencies, build output, archives, hidden tool folders.
find_files() { local d="$1"; shift; find "$d" \( -name .git -o -name node_modules -o -name vendor -o -name dist -o -name build -o -name archive -o -name backups -o -name '.?*' \) -prune -o -type f "$@" -print 2>/dev/null; }

die() { echo "lean-project: $*" >&2; exit 1; }
tok() { echo $(( $(wc -c < "$1") / 4 )); }

# Print a markdown file with a fresh contents table on stdout. Exit 3 when it has no markers.
# The table has one entry per ## and ### heading, so its length is known up front: one pass is enough.
toc_render() {
  awk -v force="${2:-0}" -v min="$TOC_MIN" -v note="$NOTE" '
    { sub(/\r$/, ""); line[++n] = $0 }
    END {
      op = 0; cl = 0
      for (i = 1; i <= n; i++) { if (line[i] == "<!-- toc -->" && !op) op = i; else if (line[i] == "<!-- /toc -->" && op && !cl) cl = i }
      if (!op || !cl) {
        if (!force && n < min) exit 3
        fence = 0; at = 0
        for (i = 1; i <= n; i++) { if (line[i] ~ /^```/) fence = !fence; if (!fence && line[i] ~ /^## /) { at = i; break } }
        if (!at) exit 4
        m = 0
        for (i = 1; i < at; i++) out[++m] = line[i]
        out[++m] = note; out[++m] = ""; out[++m] = "<!-- toc -->"; out[++m] = "<!-- /toc -->"; out[++m] = ""
        for (i = at; i <= n; i++) out[++m] = line[i]
        n = m; for (i = 1; i <= n; i++) line[i] = out[i]
        op = at + 2; cl = at + 3
      }
      # Body = everything after the old table; headings counted there, shifted by the new table size.
      fence = 0; h = 0
      for (i = cl; i <= n; i++) {
        if (line[i] ~ /^```/) fence = !fence
        if (!fence && line[i] ~ /^###? /) { h++; lvl[h] = (line[i] ~ /^### /) ? 3 : 2; pos[h] = i; t = line[i]; sub(/^#+ /, "", t); title[h] = t }
      }
      shift = op + h + 1 - cl          # new close marker line minus the old one
      total = n + shift
      for (i = 1; i <= op; i++) print line[i]
      for (k = 1; k <= h; k++) {
        end = total
        for (j = k + 1; j <= h; j++) if (lvl[j] <= lvl[k]) { end = pos[j] + shift - 1; break }
        printf "%s- %d-%d: %s\n", (lvl[k] == 3 ? "  " : ""), pos[k] + shift, end, title[k]
      }
      for (i = cl; i <= n; i++) print line[i]
    }' "$1"
}

cmd_toc() {
  local force=0 f rc tmp
  for f in "$@"; do [ "$f" = --force ] && force=1; done
  for f in "$@"; do
    [ "$f" = --force ] && continue
    [ -f "$f" ] || { echo "$f: not found"; continue; }
    tmp="$f.lean-tmp"
    toc_render "$f" "$force" > "$tmp"; rc=$?
    case $rc in
      0) mv "$tmp" "$f"; echo "$f: $(grep -c '^ *- [0-9]*-[0-9]*: ' "$f") entries, $(wc -l < "$f" | tr -d ' ') lines" ;;
      3) rm -f "$tmp"; echo "$f: under $TOC_MIN lines, no table needed (--force to add one)" ;;
      *) rm -f "$tmp"; echo "$f: no ## headings, skipped" ;;
    esac
  done
}

# Outline of one file: "start-end  signature", nested by heading level or indentation.
map_file() {
  local ext base="${1##*/}"
  case "$base" in
    *.*) ext=$(printf '%s' "${base##*.}" | tr 'A-Z' 'a-z') ;;
    *) case "$(head -n 1 "$1")" in   # no extension: go by the #! line
         '#!'*python*) ext=py ;; '#!'*node*) ext=js ;; '#!'*ruby*) ext=rb ;; '#!'*php*) ext=php ;; '#!'*sh*) ext=sh ;; *) ext=none ;;
       esac ;;
  esac
  awk -v ext="$ext" '
    function indent(s,   k, c, w) { w = 0; for (k = 1; k <= length(s); k++) { c = substr(s, k, 1); if (c == " ") w++; else if (c == "\t") w += 4; else break } return w }
    function add(level, sig) { s++; lv[s] = level; at[s] = NR; g = sig; gsub(/^[ \t]+|[ \t{]+$/, "", g); sg[s] = substr(g, 1, 110) }
    { sub(/\r$/, "") }
    ext == "md" || ext == "markdown" {
      if ($0 ~ /^```/) fence = !fence
      if (!fence && $0 ~ /^#+ /) { t = $0; match(t, /^#+/); add(RLENGTH, t) }
      next
    }
    ext == "php" {
      if ($0 ~ /^[ \t]*((abstract|final|readonly)[ \t]+)*(class|interface|trait|enum)[ \t]+[A-Za-z_]/ || $0 ~ /^[ \t]*((public|protected|private|static|abstract|final)[ \t]+)*function[ \t]+&?[A-Za-z_]/) add(indent($0), $0)
      next
    }
    ext ~ /^(js|jsx|ts|tsx|mjs|cjs|vue|svelte)$/ {
      if ($0 ~ /^[ \t]*(export[ \t]+)?(default[ \t]+)?(abstract[ \t]+)?(class|interface)[ \t]+[A-Za-z_$]/ ||
          $0 ~ /^[ \t]*(export[ \t]+)?(default[ \t]+)?(async[ \t]+)?function[ \t*]/ ||
          $0 ~ /^[ \t]*(export[ \t]+)?(const|let|var)[ \t]+[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=[ \t]*(async[ \t]+)?(function|\([^)]*\)[ \t]*=>|[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=>)/ ||
          ($0 ~ /^[ \t]+((public|private|protected|static|async|get|set|readonly)[ \t]+)*[A-Za-z_$#][A-Za-z0-9_$]*[ \t]*\([^;]*\)[ \t]*(:[^{;]*)?\{[ \t]*$/ && $0 !~ /^[ \t]*(if|for|while|switch|catch|return|else|do|with)[ \t(]/)) add(indent($0), $0)
      next
    }
    ext == "py" { if ($0 ~ /^[ \t]*(async[ \t]+)?def[ \t]+/ || $0 ~ /^[ \t]*class[ \t]+[A-Za-z_]/) add(indent($0), $0); next }
    ext == "go" { if ($0 ~ /^func[ \t]/ || $0 ~ /^type[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]+(struct|interface)/) add(0, $0); next }
    ext == "rb" { if ($0 ~ /^[ \t]*(def|class|module)[ \t]/) add(indent($0), $0); next }
    ext == "rs" { if ($0 ~ /^[ \t]*(pub(\([^)]*\))?[ \t]+)?(async[ \t]+)?(unsafe[ \t]+)?(fn|struct|enum|trait|impl|mod)[ \t<]/) add(indent($0), $0); next }
    ext ~ /^(java|kt|kts|cs|swift|scala|dart)$/ {
      if ($0 ~ /^[ \t]*((public|private|protected|internal|static|final|abstract|override|open|sealed|data|partial|async|virtual)[ \t]+)*(class|interface|enum|record|struct|object|fun|func|protocol|extension)[ \t]/ ||
          ($0 ~ /^[ \t]*(public|private|protected|internal)[ \t]+[^=;(]*\(/ && $0 !~ /;[ \t]*$/)) add(indent($0), $0)
      next
    }
    ext ~ /^(sh|bash|zsh)$/ { if ($0 ~ /^[ \t]*(function[ \t]+)?[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)[ \t]*\{?/) add(indent($0), $0); next }
    { unknown = 1 }
    END {
      if (unknown && !s) { print "(no outline for ." ext " files: use grep -n to find the lines, then read a range)"; exit }
      top = 0
      for (k = 1; k <= s; k++) {
        end = NR
        for (j = k + 1; j <= s; j++) if (lv[j] <= lv[k]) { end = at[j] - 1; break }
        while (top && lv[stack[top]] >= lv[k]) top--   # parents still open = nesting depth
        pad = ""; for (j = 0; j < top; j++) pad = pad "  "
        stack[++top] = k
        printf "%6d-%-6d %s%s\n", at[k], end, pad, sg[k]
      }
      if (!s) print "(no headings or symbols found)"
    }' "$1"
}

cmd_map() {
  local target="${1:-.}" min="${2:-300}"
  if [ -f "$target" ]; then
    echo "$target: $(wc -l < "$target" | tr -d ' ') lines"
    map_file "$target"
  elif [ -d "$target" ]; then
    echo "Files of $min+ lines under $target (map one before reading it):"
    find_files "$target" | while IFS= read -r f; do
      case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.zip|*.gz|*.pdf|*.woff*|*.ttf|*.mo|*.lock|*.min.js|*.min.css|*.map|*.svg) continue ;; esac
      n=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
      [ "${n:-0}" -ge "$min" ] && printf '%7d  %s\n' "$n" "$f"
    done | sort -rn
  else
    die "map: $target not found"
  fi
}

# Files Claude Code loads on its own for a session started in $1.
auto_loaded() {
  local d mem="" win slug f
  d=$(cd "$1" && pwd)
  { [ -f "$HOME/.claude/CLAUDE.md" ] && echo "$HOME/.claude/CLAUDE.md"
    while :; do
      for f in CLAUDE.md CLAUDE.local.md .claude/CLAUDE.md; do [ -f "$d/$f" ] && echo "$d/$f"; done
      if [ -z "$mem" ]; then
        win=$(cd "$d" && { pwd -W 2>/dev/null || pwd; })
        slug=$(printf '%s' "$win" | sed 's/[^A-Za-z0-9]/-/g')
        [ -f "$HOME/.claude/projects/$slug/memory/MEMORY.md" ] && mem="$HOME/.claude/projects/$slug/memory/MEMORY.md" && echo "$mem"
      fi
      [ "$d" = / ] || [ "$(dirname "$d")" = "$d" ] && break
      d=$(dirname "$d")
    done; } | while IFS= read -r f; do realpath "$f" 2>/dev/null || echo "$f"; done | awk '!seen[$0]++'
}

cmd_cost() {
  local dir="${1:-.}" sum=0 t f n flags auto
  [ -d "$dir" ] || die "cost: $dir is not a folder"
  auto=$(auto_loaded "$dir")
  echo "AUTO-LOADED every session (paid on every turn; ~tokens = bytes/4):"
  while IFS= read -r f; do [ -n "$f" ] || continue; t=$(tok "$f"); sum=$((sum + t)); printf '  %6d  %s\n' "$t" "$f"; done <<EOF
$auto
EOF
  printf '  %6d  total\n\n' "$sum"
  # The rest of a session's start: system prompt, tool schemas, the skill listing, MCP tool names, hook output.
  # Measured from this folder's recent transcripts: context of each session's first reply.
  local slug tdir
  slug=$(cd "$dir" && { pwd -W 2>/dev/null || pwd; } | sed 's/[^A-Za-z0-9]/-/g'); tdir="$HOME/.claude/projects/$slug"
  echo "STARTUP BASELINE (context of the first reply, last 5 sessions here; the CLAUDE.md chain is a small part):"
  ls -t "$tdir"/*.jsonl 2>/dev/null | head -n 5 | while IFS= read -r f; do
    grep -m 1 '"usage"' "$f" | grep -o '"\(input_tokens\|cache_creation_input_tokens\|cache_read_input_tokens\)":[0-9]*' | awk -F: -v d="$(date -r "$f" +%F 2>/dev/null)" '!seen[$1]++ { s += $2 } END { if (s) printf "  %6d  %s\n", s, d }'
  done
  echo "  Skill listing, user scope + this folder (~tokens of name and description; each one loads in every session):"
  for f in "$HOME"/.claude/skills/*/SKILL.md "$dir"/.claude/skills/*/SKILL.md; do
    [ -f "$f" ] && printf '%s\t%s\n' "$(basename "$(dirname "$f")" | sed 's/-.*//')" "$(awk '/^---/ { k++; next } k == 1 && /^(name|description|when_to_use):/' "$f" | wc -c)"
  done | awk -F '\t' '{ n[$1]++; c[$1] += $2 } END { for (g in n) printf "  %6d  %3d skills  %s-*\n", c[g] / 4, n[g], g }' | sort -rn
  echo "  Cut it: move skills and MCP servers that only one project uses out of user scope (~/.claude/skills, ~/.claude.json) into that project."
  echo
  echo "DOCS (paid when read, then carried for the rest of the session):"
  docs=$(find_files "$dir" -name '*.md' | sort)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n=$(wc -l < "$f" | tr -d ' '); flags=""
    if grep -q '^<!-- toc -->' "$f"; then
      toc_render "$f" | cmp -s - <(tr -d '\r' < "$f") || flags="STALE TOC"
      has=toc
    else
      has=""
      [ "$n" -ge "$TOC_MIN" ] && ! grep -qi '^## *contents' "$f" && flags="NEEDS TOC"
    fi
    case "$(basename "$f" | tr 'A-Z' 'a-z')" in *archive*) ;; *handoff*|*state*) [ "$n" -gt "$HANDOFF_MAX" ] && flags="${flags:+$flags, }STATE FILE OVER $HANDOFF_MAX LINES" ;; esac
    printf '  %6d %5d lines  %-3s  %s%s\n' "$(tok "$f")" "$n" "$has" "${f#"$dir"/}" "${flags:+  <- $flags}"
  done <<EOF
$docs
EOF
  # The same sentence in two files is paid twice and drifts apart. Archives repeat on purpose.
  printf '%s\n%s\n' "$auto" "$docs" | while IFS= read -r f; do [ -n "$f" ] && { realpath "$f" 2>/dev/null || echo "$f"; }; done | awk '!seen[$0]++' | grep -vi archive | while IFS= read -r f; do
    awk -v f="$f" -v note="$NOTE" '{ sub(/\r$/, ""); k = $0; sub(/^[ \t>#*|0-9.-]+/, "", k); k = tolower(k); if (length(k) >= 50 && k != tolower(note)) print f "\t" k }' "$f"
  done | awk -F '\t' '!pair[$0]++ { n[$2]++; where[$2] = where[$2] (n[$2] > 1 ? ", " : "") $1 }
    END { c = 0; for (k in n) if (n[k] > 1) { c++; if (c <= 10) out = out "  \"" substr(k, 1, 90) "\"\n    in " where[k] "\n" }
          printf "\nDUPLICATE LINES across files (keep one home, point to it): %d\n%s", c, out }'
  if [ -d "$dir/docs" ]; then
    local why
    why=$(docs_may_ship "$dir")
    if [ -n "$why" ]; then
      printf '\nDOCS MAY SHIP: this project is %s, and docs/ (GLOSSARY.md, PLAN.md, state) would reach users. Exclude docs/ from the build (export-ignore, files or .npmignore), or move the shipped code into a subfolder.\n' "$why"
    fi
  fi
}

# Board: one append-only log shared by the lead and its subagents ($LEAN_BOARD, default docs/BOARD.md).
# Writers only append one line each, so parallel agents never clobber each other; readers get it folded into columns.
# Line: "- <date time> | <who> | add|move|note | <id> | <text>"; who = $LEAN_AS (default lead).
cmd_board() {
  local f="${LEAN_BOARD:-docs/BOARD.md}" who verb="${1:-}" id text
  who=$(printf '%s' "${LEAN_AS:-lead}" | tr -d '|\r\n')
  case "$verb" in
    add|move|note|files)
      id="${2:-}"
      case "$id" in ''|*[!A-Za-z0-9._-]*) die "board $verb: card id is letters, digits, . _ - (like T3)" ;; esac
      shift 2
      if [ "$verb" = move ]; then
        case "${1:-}" in todo|doing|blocked|done) ;; *) die "board move: status is todo, doing, blocked or done" ;; esac
        if [ "$1" = done ] && [ -z "${LEAN_GATE_SKIP:-}" ]; then
          check_gate "$id" || return 1
        fi
      fi
      [ $# -gt 0 ] || die "board $verb: give the text"
      if [ "$verb" = files ]; then verb=note; set -- "files:" "$@"; fi
      text=$(printf '%s ' "$@" | tr '\r\n' '  ' | sed 's/ *$//')
      board_append "$verb" "$id" "$text"
      ;;
    *)
      [ -f "$f" ] || die "board: $f not found (set LEAN_BOARD, or add a card first)"
      awk -F ' [|] ' -v want="$verb" '
        { sub(/\r$/, "") }
        !/^- [0-9]/ || NF < 5 { next }
        {
          t = substr($1, 3); w = $2; v = $3; id = $4; x = $5; for (k = 6; k <= NF; k++) x = x " | " $k
          if (!(id in st)) { order[++n] = id; st[id] = "todo" }
          if (v == "add") title[id] = x
          else if (v == "move") { s = x; sub(/ .*/, "", s); st[id] = s; owner[id] = w; r = x; why[id] = sub(/^[^ ]+ /, "", r) ? r : "" }
          else if (v == "note") nt[++nn] = substr(t, 6) " " w " " id ": " x
          if (id == want) hist[++h] = "  " t "  " w "  " v "  " x
        }
        END {
          if (want != "") {
            if (!h) { print "no card " want; exit 1 }
            print want ": " title[want] " [" st[want] "]"; for (k = 1; k <= h; k++) print hist[k]; exit
          }
          split("doing blocked todo done", col, " ")
          for (c = 1; c <= 4; c++) for (k = 1; k <= n; k++) {
            i = order[k]; if (st[i] != col[c]) continue
            if (shown[c]++ == 0) print toupper(col[c])
            printf "  %-8s %s%s%s\n", i, title[i], (owner[i] != "" ? " (" owner[i] ")" : ""), (why[i] != "" ? ": " why[i] : "")
          }
          if (nn) {
            print "NOTES (latest " (nn > 10 ? 10 : nn) " of " nn "; one card in full: lean-project board <id>)"
            for (k = (nn > 10 ? nn - 9 : 1); k <= nn; k++) print "  " nt[k]
          }
        }' "$f"
      ;;
  esac
}

cmd_selftest() {
  local tmp f fail=0
  tmp=$(mktemp -d) || die "selftest: no temp dir"
  f="$tmp/doc.md"
  { echo "# T"; echo "intro"; i=0; while [ $i -lt 90 ]; do echo x; i=$((i + 1)); done
    printf '%s\n' '## A' a '### A1' a1 '```' '## not a heading' '```' '## B' b; } > "$f"
  cmd_toc "$f" > /dev/null
  [ "$(grep -c '^ *- [0-9]*-[0-9]*: ' "$f")" = 3 ] || { echo "FAIL toc entry count"; fail=1; }
  grep '^ *- [0-9]*-[0-9]*: ' "$f" | while IFS= read -r e; do
    s=$(echo "$e" | sed 's/^ *- \([0-9]*\)-.*/\1/'); t=$(echo "$e" | sed 's/^ *- [0-9]*-[0-9]*: //')
    sed -n "${s}p" "$f" | grep -qx "##* $t" || echo "FAIL toc entry points off its heading: $e"
  done | grep FAIL && fail=1
  cp "$f" "$tmp/again.md"; cmd_toc "$tmp/again.md" > /dev/null
  cmp -s "$f" "$tmp/again.md" || { echo "FAIL toc second run changed the file"; fail=1; }
  printf '%s\n' '<?php' 'class Foo {' '    public function bar() {' '    }' '    private static function baz() {' '    }' '}' 'function top() {' '}' > "$tmp/a.php"
  out=$(map_file "$tmp/a.php")
  echo "$out" | grep -q '^ *2-7 *class Foo' || { echo "FAIL map class range"; fail=1; }
  echo "$out" | grep -q '^ *3-4 *  public function bar()' || { echo "FAIL map method range"; fail=1; }
  echo "$out" | grep -q '^ *8-9 *function top()' || { echo "FAIL map top-level function"; fail=1; }
  export LEAN_BOARD="$tmp/b/BOARD.md"
  cmd_board add T1 Parser; cmd_board add T2 'API | client'
  LEAN_AS=s1 cmd_board move T1 doing; LEAN_AS=h2 cmd_board move T2 blocked needs date format
  LEAN_AS=s1 cmd_board note T1 dates are ISO 8601
  out=$(cmd_board)
  echo "$out" | grep -q '^DOING' && echo "$out" | grep -q 'T1 *Parser (s1)$' || { echo "FAIL board doing column"; fail=1; }
  echo "$out" | grep -q 'T2 *API | client (h2): needs date format$' || { echo "FAIL board blocked card"; fail=1; }
  cmd_board T1 | grep -q 'note  dates are ISO 8601$' || { echo "FAIL board card history"; fail=1; }
  # check gate: a broken PHP file sends its card back to todo; a clean one lets it reach done
  if command -v php >/dev/null 2>&1; then
    printf '<?php\necho "ok";\n' > "$tmp/good.php"
    printf '<?php\necho "ok"\n' > "$tmp/bad.php"
    cmd_board add T9 Gated > /dev/null
    cmd_board files T9 "$tmp/bad.php" > /dev/null
    cmd_board move T9 done > /dev/null 2>&1 && { echo "FAIL gate let a broken file through"; fail=1; }
    cmd_board T9 | head -n 1 | grep -q '\[todo\]' || { echo "FAIL gate did not roll the card back to todo"; fail=1; }
    cmd_board T9 | grep -q 'move  *todo gate failed' || { echo "FAIL gate reason not on the card"; fail=1; }
    cmd_board files T9 "$tmp/good.php" > /dev/null
    cmd_board move T9 done > /dev/null 2>&1 || { echo "FAIL gate blocked a clean file"; fail=1; }
    cmd_board T9 | head -n 1 | grep -q '\[done\]' || { echo "FAIL clean card not done"; fail=1; }
  fi
  # frontier: open decisions whose prerequisites are settled come first; the others wait
  printf '%s\n' '## 3. Decisions' '' '| # | Decision | Default | Status |' '|---|---|---|---|' \
    '| D1 | Storage | sqlite | decided |' '| D2 | Auth provider | none | open |' \
    '| D3 | Sync model, needs D2 | pull | open |' '| D4 | Theme | light | open |' > "$tmp/PLAN.md"
  fr=$(cmd_frontier "$tmp/PLAN.md")
  echo "$fr" | grep -q '^  D2  Auth provider$' || { echo "FAIL frontier missed D2"; fail=1; }
  echo "$fr" | grep -q '^  D3  waits for D2$' || { echo "FAIL frontier did not hold D3"; fail=1; }
  # lessons: the second sighting becomes a local rule; the entries move to the archive
  export LESSONS_FILE="$tmp/lessons/LESSONS.md"
  cmd_lesson "Haiku passes fixture work at low effort" --mode build > /dev/null
  grep -q 'Haiku passes' "$LESSONS_FILE" || { echo "FAIL lesson not recorded"; fail=1; }
  cmd_lesson "Haiku passes fixture work at low effort" --mode build > /dev/null
  grep -q '^- Haiku passes fixture work at low effort$' "$LESSONS_FILE" || { echo "FAIL repeated lesson not promoted"; fail=1; }
  grep -q '^- [0-9].*Haiku passes' "$LESSONS_FILE" && { echo "FAIL promoted entries not moved out"; fail=1; }
  grep -q 'Haiku passes' "$tmp/lessons/LESSONS-ARCHIVE.md" || { echo "FAIL promoted entries not archived"; fail=1; }
  unset LESSONS_FILE
  # audit waste: dry run changes nothing; --apply archives the comment block and leaves a pointer
  git init -q "$tmp/w"
  { echo '<?php'; i=1; while [ $i -le 9 ]; do echo "// note $i"; i=$((i + 1)); done
    echo 'echo 1;'; echo 'error_log("x");'; echo 'add_action("init", "f");'; echo 'add_action("init", "f");'; } > "$tmp/w/a.php"
  rep=$(cmd_waste "$tmp/w")
  echo "$rep" | grep -q 'a.php:2-10' || { echo "FAIL waste missed the comment block"; fail=1; }
  echo "$rep" | grep -q 'error_log' || { echo "FAIL waste missed the debug log"; fail=1; }
  echo "$rep" | grep -q 'repeated hook 2x' || { echo "FAIL waste missed the repeated hook"; fail=1; }
  [ "$(grep -c '// note' "$tmp/w/a.php")" = 9 ] || { echo "FAIL waste dry run changed the file"; fail=1; }
  cmd_waste "$tmp/w" --apply > /dev/null
  grep -q 'note 9' "$tmp/w/docs/ARCHIVE.md" || { echo "FAIL waste did not archive the block"; fail=1; }
  grep -q 'archived to docs/ARCHIVE.md' "$tmp/w/a.php" || { echo "FAIL waste left no pointer"; fail=1; }
  grep -q 'error_log' "$tmp/w/a.php" || { echo "FAIL waste removed a debug log"; fail=1; }
  # predict: a file's partners are the files committed with it
  if command -v git >/dev/null 2>&1; then
    git init -q "$tmp/p"
    (cd "$tmp/p" && echo a > a.php && echo b > b.php && git add -A && git -c user.email=t@t -c user.name=t commit -qm one \
      && echo a2 >> a.php && git add -A && git -c user.email=t@t -c user.name=t commit -qm two \
      && echo c > c.php && git add -A && git -c user.email=t@t -c user.name=t commit -qm three)
    pr=$(cmd_predict "$tmp/p/a.php")
    echo "$pr" | grep -q 'b.php' || { echo "FAIL predict missed a co-changed file"; fail=1; }
    echo "$pr" | grep -q '  c.php' && { echo "FAIL predict included an unrelated file"; fail=1; }
  fi
  # docs shipping: an npm package ships docs/ unless the build excludes it
  mkdir -p "$tmp/s/docs"; echo '{"name":"x"}' > "$tmp/s/package.json"
  [ -n "$(docs_may_ship "$tmp/s")" ] || { echo "FAIL docs ship check missed an npm package"; fail=1; }
  printf 'docs export-ignore\n' > "$tmp/s/.gitattributes"
  [ -z "$(docs_may_ship "$tmp/s")" ] || { echo "FAIL docs ship check ignored export-ignore"; fail=1; }
  # handoff: open tasks from the plan, and the cards in flight (the latest move wins; a done card is left out)
  printf '%s\n' '- [ ] write the parser' '- [x] old task' '- [ ] add tests' > "$tmp/HP.md"
  printf '%s\n' '- 2026-10-16 10:00 | lead | add | H1 | Parser | fast' '- 2026-10-16 10:01 | lead | move | H1 | doing parsing' \
    '- 2026-10-16 10:02 | lead | add | H2 | API | client' '- 2026-10-16 10:03 | lead | move | H2 | done' > "$tmp/HB.md"
  hd=$(LEAN_BOARD="$tmp/HB.md" cmd_handoff "$tmp/HP.md")
  echo "$hd" | grep -q '  - write the parser' || { echo "FAIL handoff missed an open task"; fail=1; }
  echo "$hd" | grep -q 'old task' && { echo "FAIL handoff listed a done task"; fail=1; }
  echo "$hd" | grep -q '  H1 \[doing\] Parser | fast' || { echo "FAIL handoff missed a card in flight"; fail=1; }
  echo "$hd" | grep -q 'H2' && { echo "FAIL handoff listed a done card"; fail=1; }
  # audit security: each anti-pattern is flagged on its line; escaped output is not
  mkdir -p "$tmp/sec"
  printf '%s\n' '<?php' 'echo $_GET["x"];' 'echo esc_html($_GET["x"]);' '$wpdb->query("DELETE FROM t WHERE id = $id");' \
    'eval($code);' 'add_action("wp_ajax_save", "save");' > "$tmp/sec/a.php"
  sec=$(cmd_audit_security "$tmp/sec")
  echo "$sec" | grep -q 'a.php:2: request data echoed without escaping' || { echo "FAIL security missed unescaped output"; fail=1; }
  echo "$sec" | grep -q 'a.php:3: ' && { echo "FAIL security flagged escaped output"; fail=1; }
  echo "$sec" | grep -q 'a.php:4: SQL built from a variable' || { echo "FAIL security missed unprepared SQL"; fail=1; }
  echo "$sec" | grep -q 'a.php:5: eval' || { echo "FAIL security missed eval"; fail=1; }
  echo "$sec" | grep -q 'a.php: AJAX, admin-post or REST handler' || { echo "FAIL security missed a handler with no check"; fail=1; }
  unset LEAN_BOARD

  rm -rf "$tmp"
  [ $fail = 0 ] && echo "selftest ok" || { echo "selftest FAILED"; return 1; }
}

# ---- Board writes, the gate, predict, waste, lessons, frontier, shipping check ----

# Append one board line: board_append <verb> <id> <text>. Creates the board on first use.
board_append() {
  local f="${LEAN_BOARD:-docs/BOARD.md}" who text
  who=$(printf '%s' "${LEAN_AS:-lead}" | tr -d '|\r\n')
  text=$(printf '%s' "$3" | tr '\r\n' '  ' | sed 's/ *$//')
  if [ ! -f "$f" ]; then
    mkdir -p "$(dirname "$f")" && printf '%s\n' '# Board' '' \
      '> Shared by the lead and its subagents. Append-only: write with `lean-project board add|move|note|files`, read with `lean-project board [id]`.' '' > "$f" \
      || die "board: cannot create $f"
  fi
  printf -- '- %s | %s | %s | %s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$who" "$1" "$2" "$text" >> "$f"
}

# The newest "files:" note on a card (written by: board files <id> <paths>).
card_files() {
  local f="${LEAN_BOARD:-docs/BOARD.md}"
  [ -f "$f" ] || return 0
  awk -F ' [|] ' -v id="$1" '
    { sub(/\r$/, "") }
    /^- [0-9]/ && NF >= 5 && $4 == id && $5 ~ /^files: / { s = substr($5, 8) }
    END { print s }' "$f"
}

# Gate: php -l and WordPress coding standards (phpcs) on a card's files.
# A failure moves the card back to todo and writes the tool output onto the card. Returns 1 on failure.
# Usage: check_gate <card id> [files...]   (no files: the card's newest "files:" note)
check_gate() {
  local id="${1:-}" files f php="" msgs="" out cfg warn="" rc=0
  [ -n "$id" ] || die "check gate: give the card id"
  shift
  files="$*"
  [ $# -gt 0 ] || files=$(card_files "$id")
  if [ -z "$files" ]; then echo "gate $id: no files recorded (board files $id <paths>), nothing checked"; return 0; fi
  for f in $files; do
    if [ ! -f "$f" ]; then msgs="$msgs missing file $f;"; rc=1; continue; fi
    case "$f" in *.php) php="$php $f" ;; esac
  done
  if [ -n "$php" ]; then
    if command -v php >/dev/null 2>&1; then
      for f in $php; do
        out=$(php -l "$f" 2>&1) || { msgs="$msgs $(printf '%s' "$out" | grep -v '^No syntax errors' | head -n 3 | tr '\n' ' ')"; rc=1; }
      done
    else
      warn="php not installed, syntax not checked"
    fi
    if [ $rc = 0 ] && command -v phpcs >/dev/null 2>&1; then
      cfg=""; [ -f phpcs.xml ] || [ -f phpcs.xml.dist ] || cfg="--standard=${LEAN_WPCS_STANDARD:-WordPress}"
      out=$(phpcs -n -q $cfg $php 2>&1) || {
        case "$out" in
          *"not installed"*) warn="${warn:+$warn; }WordPress coding standard not installed, coding standards not checked" ;;
          *) msgs="$msgs phpcs: $(printf '%s' "$out" | head -n 3 | tr '\n' ' ')"; rc=1 ;;
        esac
      }
    elif [ $rc = 0 ]; then
      warn="${warn:+$warn; }phpcs not installed, coding standards not checked"
    fi
  fi
  if [ $rc -ne 0 ]; then
    msgs=$(printf '%s' "$msgs" | sed 's/^ *//; s/  */ /g')
    board_append move "$id" "todo gate failed: $(printf '%s' "$msgs" | cut -c1-200)"
    board_append note "$id" "gate output: $msgs"
    echo "gate $id: FAILED, card back to todo: $msgs"
    return 1
  fi
  echo "gate $id: passed${warn:+ ($warn)}"
  return 0
}

# Predict: the files that changed in the same commits as a file, over the last 10 commits.
cmd_predict() {
  local target="${1:-}" dir top abs rel co
  [ -f "$target" ] || die "map predict: $target not found"
  echo "$target: $(wc -l < "$target" | tr -d ' ') lines"
  map_file "$target"
  dir=$(cd "$(dirname "$target")" && pwd -P)
  abs="$dir/$(basename "$target")"
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || { echo "(not in a git repository: no history to predict from)"; return 0; }
  top=$(cd "$top" && pwd -P)
  rel="${abs#"$top"/}"
  co=$(git -C "$top" log -n 10 --name-only --format='tformat:@@' 2>/dev/null | awk -v t="$rel" '
    function flush(   f) { if (has) for (f in cf) if (f != t && f != "") co[f]++; delete cf; has = 0 }
    /^@@$/ { flush(); next }
    NF { cf[$0] = 1; if ($0 == t) has = 1 }
    END { flush(); for (f in co) print co[f] "\t" f }' | sort -rn | head -n 5)
  if [ -z "$co" ]; then echo "no other file changed with $rel in the last 10 commits"; return 0; fi
  echo "CHANGED WITH $rel in the last 10 commits (commits, file):"
  printf '%s\n' "$co" | sed 's/^/  /'
  printf '%s\n' "$co" | cut -f2 | while IFS= read -r p; do
    [ -f "$top/$p" ] || continue
    echo; echo "--- $p ($(wc -l < "$top/$p" | tr -d ' ') lines)"
    map_file "$top/$p"
  done
}

# Waste: comment blocks (8+ lines), debug logs and repeated hooks. Dry run unless --apply, which
# moves comment blocks verbatim into docs/ARCHIVE.md (git repository only) and leaves a pointer.
cmd_waste() {
  local dir="." apply=0 a f rel mark runs s e n arch files dup blocks=0 logs=0 hooks=0
  for a in "$@"; do case "$a" in --apply) apply=1 ;; *) dir="$a" ;; esac; done
  [ -d "$dir" ] || die "audit waste: $dir is not a folder"
  dir=$(cd "$dir" && pwd -P)
  if [ "$apply" = 1 ] && ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "audit waste --apply needs a git repository, so every change can be reverted"
  fi
  arch="$dir/docs/ARCHIVE.md"
  files=$(find_files "$dir" \( -name '*.php' -o -name '*.js' -o -name '*.ts' -o -name '*.mjs' -o -name '*.py' -o -name '*.sh' \) | sort)
  if [ "$apply" = 1 ]; then echo "WASTE in $dir (applying: comment blocks move to docs/ARCHIVE.md)"; else echo "WASTE in $dir (dry run)"; fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$dir"/}"
    case "$f" in *.sh|*.py) mark='#' ;; *) mark='//' ;; esac
    runs=$(awk -v mark="$mark" '
      function iscomment(s) {
        if (mark == "//") return s ~ /^[ \t]*\/\//
        return s ~ /^[ \t]*#/ && s !~ /^[ \t]*#!/ && s !~ /^[ \t]*#\[/
      }
      { sub(/\r$/, "") }
      iscomment($0) { if (!run) start = NR; run++; next }
      { if (run >= 8) print start, NR - 1, run; run = 0 }
      END { if (run >= 8) print start, NR, run }' "$f")
    if [ -n "$runs" ]; then
      printf '%s\n' "$runs" | while read -r s e n; do printf '  %s:%s-%s  comment block, %s lines\n' "$rel" "$s" "$e" "$n"; done
      blocks=$((blocks + $(printf '%s\n' "$runs" | grep -c .)))
      if [ "$apply" = 1 ]; then
        [ -f "$arch" ] || { mkdir -p "$(dirname "$arch")"; printf '%s\n\n' '# Archive' > "$arch"; }
        printf '\n## waste %s: %s\n\n' "$(date +%F)" "$rel" >> "$arch"
        printf '%s\n' "$runs" | sort -k1,1nr | while read -r s e n; do
          { printf '````\n'; sed -n "${s},${e}p" "$f"; printf '````\n\n'; } >> "$arch"
          { head -n $((s - 1)) "$f"; printf '%s archived to docs/ARCHIVE.md (%s, lines %s-%s)\n' "$mark" "$rel" "$s" "$e"; tail -n +$((e + 1)) "$f"; } > "$f.lean-tmp" && mv "$f.lean-tmp" "$f"
        done
      fi
    fi
    case "$f" in *.php)
      if grep -q 'error_log(' "$f" 2>/dev/null; then
        grep -n 'error_log(' "$f" | while IFS= read -r l; do printf '  %s:%s  debug log: error_log() (reported, not removed)\n' "$rel" "${l%%:*}"; done
        logs=$((logs + $(grep -c 'error_log(' "$f")))
      fi
      dup=$(awk '
        { sub(/\r$/, "") }
        /^[ \t]*add_(action|filter)\(/ { t = $0; sub(/^[ \t]+/, "", t); c[t]++; if (c[t] == 2) order[++m] = t; at[t] = at[t] " " NR }
        END { for (i = 1; i <= m; i++) print c[order[i]] "\t" order[i] "\t" at[order[i]] }' "$f")
      if [ -n "$dup" ]; then
        printf '%s\n' "$dup" | while IFS="$(printf '\t')" read -r n t at; do
          printf '  %s  repeated hook %sx, lines%s: %s (reported, not removed)\n' "$rel" "$n" "$at" "$t"
        done
        hooks=$((hooks + $(printf '%s\n' "$dup" | grep -c .)))
      fi
      ;;
    esac
  done <<EOF
$files
EOF
  echo "TOTAL: $blocks comment block(s), $logs debug log line(s), $hooks repeated hook(s)"
  [ "$apply" = 1 ] || [ "$blocks" = 0 ] || echo "Dry run: nothing changed. Run with --apply to move the comment blocks (git reverts them). Debug logs and repeated hooks are never removed: removing them changes behaviour."
  return 0
}

# Lessons: the file lives in the plugin data folder (LESSONS_FILE overrides it, for tests).
lessons_file() {
  if [ -n "${LESSONS_FILE:-}" ]; then printf '%s\n' "$LESSONS_FILE"; return 0; fi
  if [ -n "${CLAUDE_PLUGIN_DATA:-}" ]; then printf '%s\n' "$CLAUDE_PLUGIN_DATA/LESSONS.md"; return 0; fi
  local g
  g=$(ls -d "$HOME"/.claude/plugins/data/lean-project-*/ 2>/dev/null | head -n 1)
  printf '%s\n' "${g:-$HOME/.claude/plugins/data/lean-project/}LESSONS.md"
}

# Move every entry with this key to LESSONS-ARCHIVE.md (verbatim) and add the rule under "## Local rules" once.
# Usage: lesson_promote <lessons file> <key> <rule line>
lesson_promote() {
  local f="$1" arch
  arch="$(dirname "$f")/LESSONS-ARCHIVE.md"
  awk -v key="$2" -v rule="$3" -v arch="$arch" '
    function norm(s) { s = tolower(s); gsub(/[^a-z0-9]+/, " ", s); sub(/^ /, "", s); sub(/ $/, "", s); return s }
    function body(s) { sub(/^- [^|]*\| [^|]*\| [^|]*\| /, "", s); return s }
    FNR == NR { sub(/\r$/, ""); if ($0 ~ /^## /) s1 = $0; if (s1 == "## Local rules" && $0 ~ /^- / && norm($0) == key) have = 1; next }
    { sub(/\r$/, "") }
    /^## / { sec = $0 }
    sec == "## Entries" && /^- [0-9]/ && norm(body($0)) == key { print >> arch; next }
    { print }
    /^## Local rules/ && !have && !added { print rule; added = 1 }' "$f" "$f" > "$f.lean-tmp" && mv "$f.lean-tmp" "$f"
}

lesson_key() { printf '%s\n' "$1" | awk '{ $0 = tolower($0); gsub(/[^a-z0-9]+/, " "); sub(/^ /, ""); sub(/ $/, ""); print }'; }

cmd_lesson() {
  local text="" mode="-" proj="-" f key n rule lines
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) mode="${2:-}"; shift 2 ;;
      --project) proj="${2:-}"; shift 2 ;;
      *) text="${text:+$text }$1"; shift ;;
    esac
  done
  [ -n "$text" ] || die 'lesson: give the text, e.g. lean-project lesson "Haiku passes fixture work at low effort" --mode build'
  text=$(printf '%s' "$text" | tr '\r\n' '  ' | sed 's/ *$//')
  f=$(lessons_file)
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || printf '%s\n' '# Lessons' '' '## Local rules' '' '## Entries' '' > "$f"
  key=$(lesson_key "$text")
  n=$(awk -v key="$key" '
    function norm(s) { s = tolower(s); gsub(/[^a-z0-9]+/, " ", s); sub(/^ /, "", s); sub(/ $/, "", s); return s }
    function body(s) { sub(/^- [^|]*\| [^|]*\| [^|]*\| /, "", s); return s }
    { sub(/\r$/, "") }
    /^## / { sec = $0 }
    sec == "## Entries" && /^- [0-9]/ && norm(body($0)) == key { c++ }
    END { print c + 0 }' "$f")
  rule=$(awk -v key="$key" '
    function norm(s) { s = tolower(s); gsub(/[^a-z0-9]+/, " ", s); sub(/^ /, "", s); sub(/ $/, "", s); return s }
    { sub(/\r$/, "") }
    /^## / { sec = $0 }
    sec == "## Local rules" && /^- / && norm($0) == key { print 1; exit }' "$f")
  printf -- '- %s | %s | %s | %s\n' "$(date +%F)" "$proj" "$mode" "$text" >> "$f"
  n=$((n + 1))
  if [ "$n" -ge 2 ] || [ "${rule:-0}" = 1 ]; then
    lesson_promote "$f" "$key" "- $text"
    echo "promoted to Local rules (seen $n time(s)): $text"
  else
    echo "recorded (seen $n time; a second sighting makes it a local rule)"
  fi
  lines=$(wc -l < "$f" | tr -d ' ')
  if [ "$lines" -gt 60 ]; then echo "lessons file is $lines lines: keep it under 60 by promoting or archiving older entries"; fi
  return 0
}

cmd_lessons() {
  local f
  f=$(lessons_file)
  echo "LESSONS: $f"
  if [ ! -f "$f" ]; then echo '(none yet: lean-project lesson "<text>" records one)'; return 0; fi
  awk '/^## / { p = ($0 == "## Local rules") } p' "$f"
  echo "entries: $(awk '/^## / { s = $0 } s == "## Entries" && /^- [0-9]/' "$f" | wc -l | tr -d ' '), file: $(wc -l < "$f" | tr -d ' ') lines"
}

# Frontier: decisions in a plan's table (| D# | decision | default | status |). "needs D2" in the text makes one wait.
cmd_frontier() {
  local f="${1:-docs/PLAN.md}"
  [ -f "$f" ] || die "frontier: $f not found (give the plan path)"
  awk '
    { sub(/\r$/, "") }
    /^\| *D[0-9]+ *\|/ {
      n = split($0, c, "|")
      id = c[2]; gsub(/ /, "", id)
      title = c[3]; gsub(/^ +| +$/, "", title)
      st = tolower(c[n - 1]); gsub(/ /, "", st)
      if (!(id in status)) order[++k] = id
      status[id] = st; text[id] = title
      rest = $0
      while (match(rest, /needs[^|]*/)) {
        seg = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
        while (match(seg, /D[0-9]+/)) { need[id] = need[id] " " substr(seg, RSTART, RLENGTH); seg = substr(seg, RSTART + RLENGTH) }
      }
    }
    END {
      for (i = 1; i <= k; i++) if (status[order[i]] ~ /^open/) nopen++
      print "DECIDED " (k - nopen + 0) ", OPEN " (nopen + 0)
      if (!nopen) { print "FRONTIER empty: every decision is settled"; exit }
      print "ASK NOW (open, every prerequisite decided):"
      for (i = 1; i <= k; i++) {
        id = order[i]; if (status[id] !~ /^open/) continue
        m = split(need[id], dep, " "); blocked = ""
        for (j = 1; j <= m; j++) if (!(dep[j] in status) || status[dep[j]] ~ /^open/) blocked = blocked " " dep[j]
        if (blocked == "") { print "  " id "  " text[id]; front++ }
        else waiting[++w] = "  " id "  waits for" blocked
      }
      if (w) { print "WAITING:"; for (j = 1; j <= w; j++) print waiting[j] }
      if (!front) print "STUCK: every open decision waits on another; check the needs references for cycles or unknown IDs"
    }' "$f"
}

# Why a project folder would ship its docs/ in a build, or nothing when the build excludes docs/.
docs_may_ship() {
  local d="$1" p
  [ -f "$d/.gitattributes" ] && grep -q 'docs.*export-ignore' "$d/.gitattributes" && return 0
  [ -f "$d/.npmignore" ] && grep -q '^/\{0,1\}docs/\{0,1\}$' "$d/.npmignore" && return 0
  if [ -f "$d/package.json" ] && grep -q '"files"' "$d/package.json" && ! grep -q '"docs' "$d/package.json"; then return 0; fi
  p=$(grep -l 'Plugin Name:' "$d"/*.php 2>/dev/null | head -n 1)
  [ -n "$p" ] && { echo "a WordPress plugin ($(basename "$p"))"; return 0; }
  grep -q 'Theme Name:' "$d/style.css" 2>/dev/null && { echo "a WordPress theme"; return 0; }
  [ -f "$d/package.json" ] && ! grep -q '"private": *true' "$d/package.json" && echo "an npm package (package.json is not private)"
  return 0
}

# ---- Handoff (state compiler) and security audit ----

# Handoff: a draft of the state file. Branch, the next open tasks in PLAN.md, and the board cards in flight.
# Prints the draft for review; writes nothing.
cmd_handoff() {
  local plan="${1:-docs/PLAN.md}" board="${LEAN_BOARD:-docs/BOARD.md}" branch next flight
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(not a git repository)")
  next=""; [ -f "$plan" ] && next=$(grep -m 3 '^- \[ \]' "$plan" | sed 's/^- \[ \] /  - /')
  flight=""
  [ -f "$board" ] && flight=$(awk -F ' [|] ' '
    function rest(   t, k) { t = $5; for (k = 6; k <= NF; k++) t = t " | " $k; return t }
    /^- [0-9]/ && NF >= 5 {
      if ($3 == "add") { ttl[$4] = rest(); if (!($4 in st)) st[$4] = "todo" }
      if ($3 == "move") { s = $5; sub(/ .*/, "", s); st[$4] = s }
    }
    END { for (id in st) if (st[id] == "doing" || st[id] == "blocked") printf "  %s [%s] %s\n", id, st[id], ttl[id] }' "$board" | sort)
  echo "HANDOFF DRAFT: review it, add your gotchas, paste it into the state file (20 lines or fewer)"
  echo "Branch: $branch"
  echo "Next tasks:"
  if [ -n "$next" ]; then echo "$next"; else echo "  (none: no open '- [ ]' task in $plan)"; fi
  echo "In flight:"
  if [ -n "$flight" ]; then echo "$flight"; else echo "  (none)"; fi
  echo "Gotchas: (uncommitted work, workarounds, caveats)"
}

# Security patterns for WordPress, WooCommerce and Bricks code. Heuristic: each finding is a line to read, not proof.
SEC_AWK='
  { sub(/\r$/, ""); line[NR] = $0; all = all $0 "\n" }
  function out(i, msg) { if (i) printf "%s:%d: %s\n", rel, i, msg; else printf "%s: %s\n", rel, msg }
  END {
    for (i = 1; i <= NR; i++) {
      l = line[i]
      if (l ~ /^[ \t]*(\/\/|#|\*|\/\*)/) continue
      if (lang == "js") {
        if (l ~ /innerHTML[ \t]*=|dangerouslySetInnerHTML/) out(i, "HTML set from script: check the value is escaped or trusted")
        continue
      }
      if (l ~ /(echo|print)[^;]*\$_(GET|POST|REQUEST|COOKIE)/ && l !~ /esc_|wp_kses|absint|intval|sanitize_/) out(i, "request data echoed without escaping")
      if (l ~ /\$wpdb->(query|get_results|get_var|get_row|get_col)\(/ && l !~ /prepare\(/ && l ~ /\$[a-zA-Z_]/) out(i, "SQL built from a variable: check it goes through $wpdb->prepare()")
      if (l ~ /(^|[^a-z_])(eval|assert)[ \t]*\(/ || l ~ /unserialize[ \t]*\(/) out(i, "eval, assert or unserialize: never on request or stored data")
      if (l ~ /(include|require)(_once)?[ \t(].*\$_(GET|POST|REQUEST)/) out(i, "file included from request data")
      if (l ~ /(shell_exec|exec|system|passthru|popen)[ \t]*\(.*\$_/) out(i, "shell command built from request data")
      if (l ~ /(update_option|add_option|update_post_meta|update_user_meta|update_term_meta)[ \t]*\(.*\$_(POST|GET|REQUEST)/ && l !~ /sanitize_|absint|intval|wp_kses|esc_/) out(i, "request data stored without sanitize_*")
      if (l ~ /[^_]wp_redirect[ \t]*\(/ && l ~ /\$_(GET|POST|REQUEST)/) out(i, "redirect to request data: use wp_safe_redirect() and check the target")
      if (l ~ /__return_true/ && all ~ /register_rest_route/) out(i, "REST route open to everyone (__return_true): fine for public reads only")
    }
    if (lang == "php") {
      if (all ~ /wp_ajax_|admin_post_|register_rest_route/ && all !~ /current_user_can|check_ajax_referer|check_admin_referer|wp_verify_nonce|permission_callback/) out(0, "AJAX, admin-post or REST handler with no capability or nonce check in this file")
      if (all ~ /\$_FILES/ && all !~ /wp_handle_upload|wp_handle_sideload|wp_check_filetype/) out(0, "uploads read from $_FILES without a WordPress upload check")
    }
  }'

# Audit security: read-only scan of PHP and JS for the WordPress anti-patterns in SEC_AWK, one line per finding.
# Give a folder to scan all of it, or the edited files to scan only those (the review scope rule).
cmd_audit_security() {
  local dir="${1:-.}" f rel lang out files
  if [ -f "$1" ]; then
    files=$(printf '%s\n' "$@" | grep -E '\.(php|js)$' | sort -u)
    dir=$(pwd -P)
  else
    [ -d "$dir" ] || die "audit security: $dir is not a folder"
    dir=$(cd "$dir" && pwd -P)
    files=$(find_files "$dir" \( -name '*.php' -o -name '*.js' \) | sort)
  fi
  out=$(while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$dir"/}"
    case "$f" in *.php) lang=php ;; *) lang=js ;; esac
    awk -v rel="$rel" -v lang="$lang" "$SEC_AWK" "$f"
  done <<EOF
$files
EOF
)
  [ -n "$out" ] && printf '%s\n' "$out"
  echo "SECURITY AUDIT: $(printf '%s' "$out" | grep -c .) finding(s) in $(printf '%s\n' "$files" | grep -c .) file(s). Heuristic: read each line, do not trust it blindly. Fixes: skills/lean-project/WORDPRESS.md, Fixes section."
  return 0
}

# Performance and HPOS scan: runs scripts/scan.sh of the wp-woo-performance-audit skill (its own public repo).
# Looks in $WP_PERF_AUDIT_HOME, then the user's skills folder. Read-only.
cmd_audit_perf() {
  local home="${WP_PERF_AUDIT_HOME:-$HOME/.claude/skills/wp-woo-performance-audit}"
  [ -f "$home/scripts/scan.sh" ] || { echo "audit perf: the wp-woo-performance-audit skill is not at $home. Install it from github.com/nikola-vladimirov/wp-woo-performance-audit into ~/.claude/skills, or set WP_PERF_AUDIT_HOME." >&2; return 1; }
  bash "$home/scripts/scan.sh" "$@"
}

# Delegation: send a brief to the runner this project chose and write the answer to a file. The choice lives in
# <project>/.lean-project as key=value lines, set by the user's answer on first run. Runners: none, llama, opencode.
DELEGATE_CFG=".lean-project"
DEFAULT_LLAMA_URL="http://127.0.0.1:9931"
DEFAULT_LLAMA_MODEL="yuxinlu1/gemma-4-12B-coder-fable5-composer2.5-v1-GGUF:Q4_K_M"
DEFAULT_OLLAMA_URL="http://127.0.0.1:11434"    # Ollama's default port; the model is set with ollama_model
DEFAULT_UNSLOTH_URL="http://127.0.0.1:8888"    # Unsloth Studio's default port (`unsloth studio -p`); the key comes from UNSLOTH_API_KEY
# The desktop app updates its CLI folder (cli/<version>), so take the newest installed copy.
DEFAULT_OPENCODE_CLI=$(ls -1 "$HOME"/AppData/Roaming/ai.opencode.desktop/cli/*/opencode-cli.exe 2>/dev/null | sort -V | tail -n 1)
DEFAULT_OPENCODE_MODEL="opencode/deepseek-v4.1-flash-free"
cfg_get() { [ -f "$DELEGATE_CFG" ] && sed -n "s/^$1=//p" "$DELEGATE_CFG" | tail -n 1; }
# Is a runner up right now? Each HTTP runner answers its health check; CLI runners need their program installed.
runner_up() {
  local u c
  case "$1" in
    llama) u=$(cfg_get llama_url); curl -s -m 3 "${u:-$DEFAULT_LLAMA_URL}/health" >/dev/null ;;
    ollama) u=$(cfg_get ollama_url); curl -s -m 3 "${u:-$DEFAULT_OLLAMA_URL}/api/tags" >/dev/null ;;
    unsloth) u=$(cfg_get unsloth_url); curl -s -m 3 -H "Authorization: Bearer ${UNSLOTH_API_KEY:-}" "${u:-$DEFAULT_UNSLOTH_URL}/v1/models" >/dev/null ;;
    opencode) c=$(cfg_get opencode_cli); [ -f "${c:-$DEFAULT_OPENCODE_CLI}" ] ;;
    aider) command -v aider >/dev/null 2>&1 ;;
    goose) command -v goose >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}
# Runners to try in order: the chosen one, then the fallbacks (default llama, then opencode), no repeats.
# Empty when the project chose none, so the work stays with Claude.
delegate_chain() {
  local first fb r out=""
  first=$(cfg_get runner); fb=$(cfg_get fallback); fb=${fb:-llama opencode}
  [ -n "$first" ] && [ "$first" != none ] || return 0
  for r in $first $(echo "$fb" | tr ',' ' '); do
    case " $out " in *" $r "*) ;; *) out="$out $r" ;; esac
  done
  echo $out
}
# One OpenAI-compatible chat request (llama.cpp, Ollama, Unsloth Studio). $5 is an optional bearer key.
openai_chat() {
  local url="$1" model="$2" brief="$3" out="$4" key="${5:-}"
  [ -n "$model" ] || return 1
  node -e 'process.stdout.write(JSON.stringify({model:process.argv[2],messages:[{role:"user",content:require("fs").readFileSync(process.argv[1],"utf8")}],temperature:0.2,stream:false}))' "$brief" "$model" \
    | curl -s -m 900 -H 'Content-Type: application/json' ${key:+-H "Authorization: Bearer $key"} -d @- "$url/v1/chat/completions" \
    | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).choices[0].message.content+"\n")}catch(e){process.exit(1)}})' > "$out" 2>/dev/null || return 1
}
# Send the brief to one runner. Returns non-zero when it fails, so the caller can try the next runner.
# aider and goose are agents that can edit files: use them only where edits are wanted, and check git diff.
run_on() {
  local runner="$1" brief="$2" out="$3" url model cli
  case "$runner" in
    llama)
      url=$(cfg_get llama_url); model=$(cfg_get llama_model)
      openai_chat "${url:-$DEFAULT_LLAMA_URL}" "${model:-$DEFAULT_LLAMA_MODEL}" "$brief" "$out" || return 1 ;;
    ollama)
      url=$(cfg_get ollama_url); model=$(cfg_get ollama_model)
      openai_chat "${url:-$DEFAULT_OLLAMA_URL}" "$model" "$brief" "$out" || return 1 ;;
    unsloth)
      url=$(cfg_get unsloth_url); model=$(cfg_get unsloth_model)
      openai_chat "${url:-$DEFAULT_UNSLOTH_URL}" "$model" "$brief" "$out" "${UNSLOTH_API_KEY:-}" || return 1 ;;
    opencode)
      cli=$(cfg_get opencode_cli); cli=${cli:-$DEFAULT_OPENCODE_CLI}; model=$(cfg_get opencode_model); model=${model:-$DEFAULT_OPENCODE_MODEL}
      "$cli" run --model "$model" --auto --format json --file "$brief" "Do the task in the attached brief. Reply with the result only." 2>/dev/null \
        | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{let o="";for(const l of s.split("\n")){try{const e=JSON.parse(l);if(e.type==="text")o+=e.part.text}catch(_){}}process.stdout.write(o+"\n")})' > "$out" || return 1 ;;
    aider)
      model=$(cfg_get aider_model); [ -n "$model" ] || return 1
      aider --model "$model" --message-file "$brief" --yes-always --no-auto-commits > "$out" 2>/dev/null || return 1 ;;
    goose)
      goose run -i "$brief" > "$out" 2>/dev/null || return 1 ;;
    *) return 1 ;;
  esac
  [ -s "$out" ]
}

cmd_delegate() {
  local sub="${1:-}" runner url cli model r
  [ $# -gt 0 ] && shift
  case "$sub" in
    config)
      if [ -f "$DELEGATE_CFG" ]; then cat "$DELEGATE_CFG"
      else echo "no delegation choice for this project: ask the user (none, llama, ollama, unsloth, opencode, aider, goose), then 'lean-project delegate set runner <value>'"; fi ;;
    set)
      [ $# -eq 2 ] || die "delegate set: give <key> <value>"
      case "$1" in
        runner) case "$2" in none|llama|ollama|unsloth|opencode|aider|goose) ;; *) die "delegate set: runner is none, llama, ollama, unsloth, opencode, aider or goose" ;; esac ;;
        llama_url|llama_model|ollama_url|ollama_model|unsloth_url|unsloth_model|aider_model|opencode_cli) ;;
        fallback) case "$2" in *[!a-z,\ ]*|'') die "delegate set: fallback is a list of llama and opencode, e.g. 'llama opencode'" ;; esac ;;
        opencode_model) case "$2" in opencode/*-free) ;; *) die "delegate set: opencode_model must be an opencode/*-free model" ;; esac ;;
        *) die "delegate set: unknown key $1 (runner, fallback, llama_url, llama_model, ollama_url, ollama_model, unsloth_url, unsloth_model, aider_model, opencode_cli, opencode_model)" ;;
      esac
      touch "$DELEGATE_CFG"; sed -i "/^$1=/d" "$DELEGATE_CFG"; echo "$1=$2" >> "$DELEGATE_CFG"
      echo "saved $1=$2 in $DELEGATE_CFG" ;;
    check)
      runner=$(cfg_get runner); runner=${runner:-none}
      if [ "$runner" = none ]; then echo "delegation off: do the work here"
      elif runner_up "$runner"; then echo "$runner is up"
      else echo "$runner is down: delegation falls back in order ($(delegate_chain))"; fi ;;
    pick)
      for r in $(delegate_chain); do
        runner_up "$r" && { echo "$r"; return 0; }
      done
      echo none ;;
    run)
      [ $# -eq 2 ] || die "delegate run: give <brief file> <output file>"
      [ -f "$1" ] || die "delegate run: no brief at $1"
      for r in $(delegate_chain); do
        runner_up "$r" || { echo "lean-project: $r is down, trying the next runner" >&2; continue; }
        if run_on "$r" "$1" "$2"; then
          echo "delegated to $r: $(tok "$2") tokens in $2. Verify it before using it."; return 0
        fi
        echo "lean-project: $r gave no answer, trying the next runner" >&2
      done
      [ -n "$(delegate_chain)" ] && echo "lean-project: no delegation runner is up: do the work here" >&2 \
        || echo "lean-project: delegation is off for this project: do the work here" >&2
      return 3 ;;
    *) die "delegate: 'config', 'set <key> <value>', 'check', 'pick' or 'run <brief> <output>'" ;;
  esac
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  map)
    if [ "${1:-}" = predict ]; then shift; [ $# -gt 0 ] || die "map predict: give a file"; cmd_predict "$@"; else cmd_map "$@"; fi ;;
  toc) [ $# -gt 0 ] || die "toc: give one or more .md files"; cmd_toc "$@" ;;
  cost) cmd_cost "${1:-.}" ;;
  selftest) cmd_selftest ;;
  board) cmd_board "$@" || exit 1 ;;
  check) [ "${1:-}" = gate ] || die "check: only 'check gate <card id> [files]'"; shift; check_gate "$@" || exit 1 ;;
  handoff) cmd_handoff "$@" ;;
  audit)
    case "${1:-}" in
      waste) shift; cmd_waste "$@" ;;
      security) shift; cmd_audit_security "$@" ;;
      perf) shift; cmd_audit_perf "$@" || exit 1 ;;
      *) die "audit: 'audit waste [dir] [--apply]', 'audit security [dir or files...]' or 'audit perf [dir or files...]'" ;;
    esac ;;
  frontier) cmd_frontier "$@" ;;
  lesson) cmd_lesson "$@" ;;
  lessons) cmd_lessons ;;
  delegate) cmd_delegate "$@" ;;
  *) sed -n '5,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
