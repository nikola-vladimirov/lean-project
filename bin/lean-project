#!/usr/bin/env bash
# lean-project: read less, pay less. Maps and contents tables so Claude opens only the lines it needs,
# and a cost report of what a session pays before doing any work. Bash + POSIX awk only.
#
#   lean-project map <file>              outline with line ranges (markdown headings, code symbols)
#   lean-project map <dir> [min_lines]   files at or over min_lines (default 300): map those before reading
#   lean-project toc <file>... [--force] build or refresh a "<!-- toc -->" table inside markdown docs
#   lean-project cost [dir]              auto-loaded files, every doc with flags, duplicated lines
#   lean-project selftest                check the tool on this machine
set -u

TOC_MIN=80        # below this a table costs more than it saves
HANDOFF_MAX=60
NOTE='Contents table below: open only the section you need.'
# Folders never worth scanning: VCS, dependencies, build output, archives, hidden tool folders.
find_files() { local d="$1"; shift; find "$d" \( -name .git -o -name node_modules -o -name vendor -o -name dist -o -name build -o -name archive -o -name backups -o -name '.?*' \) -prune -o -type f "$@" -print 2>/dev/null; }

die() { echo "lean-project: $*" >&2; exit 1; }
tok() { echo $(( $(wc -c < "$1") / 4 )); }

# Print a markdown file with a fresh contents table on stdout. Exit 3 when it has no markers.
# The table has one entry per ## and ### heading, so its length is known up front: one pass is enough.
toc_render() {
  awk -v force="${2:-0}" -v min="$TOC_MIN" -v note="$NOTE" '
    { sub(/\r$/, ""); line[++n] = $0 }
    END {
      op = 0; cl = 0
      for (i = 1; i <= n; i++) { if (line[i] == "<!-- toc -->" && !op) op = i; else if (line[i] == "<!-- /toc -->" && op && !cl) cl = i }
      if (!op || !cl) {
        if (!force && n < min) exit 3
        fence = 0; at = 0
        for (i = 1; i <= n; i++) { if (line[i] ~ /^```/) fence = !fence; if (!fence && line[i] ~ /^## /) { at = i; break } }
        if (!at) exit 4
        m = 0
        for (i = 1; i < at; i++) out[++m] = line[i]
        out[++m] = note; out[++m] = ""; out[++m] = "<!-- toc -->"; out[++m] = "<!-- /toc -->"; out[++m] = ""
        for (i = at; i <= n; i++) out[++m] = line[i]
        n = m; for (i = 1; i <= n; i++) line[i] = out[i]
        op = at + 2; cl = at + 3
      }
      # Body = everything after the old table; headings counted there, shifted by the new table size.
      fence = 0; h = 0
      for (i = cl; i <= n; i++) {
        if (line[i] ~ /^```/) fence = !fence
        if (!fence && line[i] ~ /^###? /) { h++; lvl[h] = (line[i] ~ /^### /) ? 3 : 2; pos[h] = i; t = line[i]; sub(/^#+ /, "", t); title[h] = t }
      }
      shift = op + h + 1 - cl          # new close marker line minus the old one
      total = n + shift
      for (i = 1; i <= op; i++) print line[i]
      for (k = 1; k <= h; k++) {
        end = total
        for (j = k + 1; j <= h; j++) if (lvl[j] <= lvl[k]) { end = pos[j] + shift - 1; break }
        printf "%s- %d-%d: %s\n", (lvl[k] == 3 ? "  " : ""), pos[k] + shift, end, title[k]
      }
      for (i = cl; i <= n; i++) print line[i]
    }' "$1"
}

cmd_toc() {
  local force=0 f rc tmp
  for f in "$@"; do [ "$f" = --force ] && force=1; done
  for f in "$@"; do
    [ "$f" = --force ] && continue
    [ -f "$f" ] || { echo "$f: not found"; continue; }
    tmp="$f.lean-tmp"
    toc_render "$f" "$force" > "$tmp"; rc=$?
    case $rc in
      0) mv "$tmp" "$f"; echo "$f: $(grep -c '^ *- [0-9]*-[0-9]*: ' "$f") entries, $(wc -l < "$f" | tr -d ' ') lines" ;;
      3) rm -f "$tmp"; echo "$f: under $TOC_MIN lines, no table needed (--force to add one)" ;;
      *) rm -f "$tmp"; echo "$f: no ## headings, skipped" ;;
    esac
  done
}

# Outline of one file: "start-end  signature", nested by heading level or indentation.
map_file() {
  local ext base="${1##*/}"
  case "$base" in
    *.*) ext=$(printf '%s' "${base##*.}" | tr 'A-Z' 'a-z') ;;
    *) case "$(head -n 1 "$1")" in   # no extension: go by the #! line
         '#!'*python*) ext=py ;; '#!'*node*) ext=js ;; '#!'*ruby*) ext=rb ;; '#!'*php*) ext=php ;; '#!'*sh*) ext=sh ;; *) ext=none ;;
       esac ;;
  esac
  awk -v ext="$ext" '
    function indent(s,   k, c, w) { w = 0; for (k = 1; k <= length(s); k++) { c = substr(s, k, 1); if (c == " ") w++; else if (c == "\t") w += 4; else break } return w }
    function add(level, sig) { s++; lv[s] = level; at[s] = NR; g = sig; gsub(/^[ \t]+|[ \t{]+$/, "", g); sg[s] = substr(g, 1, 110) }
    { sub(/\r$/, "") }
    ext == "md" || ext == "markdown" {
      if ($0 ~ /^```/) fence = !fence
      if (!fence && $0 ~ /^#+ /) { t = $0; match(t, /^#+/); add(RLENGTH, t) }
      next
    }
    ext == "php" {
      if ($0 ~ /^[ \t]*((abstract|final|readonly)[ \t]+)*(class|interface|trait|enum)[ \t]+[A-Za-z_]/ || $0 ~ /^[ \t]*((public|protected|private|static|abstract|final)[ \t]+)*function[ \t]+&?[A-Za-z_]/) add(indent($0), $0)
      next
    }
    ext ~ /^(js|jsx|ts|tsx|mjs|cjs|vue|svelte)$/ {
      if ($0 ~ /^[ \t]*(export[ \t]+)?(default[ \t]+)?(abstract[ \t]+)?(class|interface)[ \t]+[A-Za-z_$]/ ||
          $0 ~ /^[ \t]*(export[ \t]+)?(default[ \t]+)?(async[ \t]+)?function[ \t*]/ ||
          $0 ~ /^[ \t]*(export[ \t]+)?(const|let|var)[ \t]+[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=[ \t]*(async[ \t]+)?(function|\([^)]*\)[ \t]*=>|[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=>)/ ||
          ($0 ~ /^[ \t]+((public|private|protected|static|async|get|set|readonly)[ \t]+)*[A-Za-z_$#][A-Za-z0-9_$]*[ \t]*\([^;]*\)[ \t]*(:[^{;]*)?\{[ \t]*$/ && $0 !~ /^[ \t]*(if|for|while|switch|catch|return|else|do|with)[ \t(]/)) add(indent($0), $0)
      next
    }
    ext == "py" { if ($0 ~ /^[ \t]*(async[ \t]+)?def[ \t]+/ || $0 ~ /^[ \t]*class[ \t]+[A-Za-z_]/) add(indent($0), $0); next }
    ext == "go" { if ($0 ~ /^func[ \t]/ || $0 ~ /^type[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]+(struct|interface)/) add(0, $0); next }
    ext == "rb" { if ($0 ~ /^[ \t]*(def|class|module)[ \t]/) add(indent($0), $0); next }
    ext == "rs" { if ($0 ~ /^[ \t]*(pub(\([^)]*\))?[ \t]+)?(async[ \t]+)?(unsafe[ \t]+)?(fn|struct|enum|trait|impl|mod)[ \t<]/) add(indent($0), $0); next }
    ext ~ /^(java|kt|kts|cs|swift|scala|dart)$/ {
      if ($0 ~ /^[ \t]*((public|private|protected|internal|static|final|abstract|override|open|sealed|data|partial|async|virtual)[ \t]+)*(class|interface|enum|record|struct|object|fun|func|protocol|extension)[ \t]/ ||
          ($0 ~ /^[ \t]*(public|private|protected|internal)[ \t]+[^=;(]*\(/ && $0 !~ /;[ \t]*$/)) add(indent($0), $0)
      next
    }
    ext ~ /^(sh|bash|zsh)$/ { if ($0 ~ /^[ \t]*(function[ \t]+)?[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)[ \t]*\{?/) add(indent($0), $0); next }
    { unknown = 1 }
    END {
      if (unknown && !s) { print "(no outline for ." ext " files: use grep -n to find the lines, then read a range)"; exit }
      top = 0
      for (k = 1; k <= s; k++) {
        end = NR
        for (j = k + 1; j <= s; j++) if (lv[j] <= lv[k]) { end = at[j] - 1; break }
        while (top && lv[stack[top]] >= lv[k]) top--   # parents still open = nesting depth
        pad = ""; for (j = 0; j < top; j++) pad = pad "  "
        stack[++top] = k
        printf "%6d-%-6d %s%s\n", at[k], end, pad, sg[k]
      }
      if (!s) print "(no headings or symbols found)"
    }' "$1"
}

cmd_map() {
  local target="${1:-.}" min="${2:-300}"
  if [ -f "$target" ]; then
    echo "$target: $(wc -l < "$target" | tr -d ' ') lines"
    map_file "$target"
  elif [ -d "$target" ]; then
    echo "Files of $min+ lines under $target (map one before reading it):"
    find_files "$target" | while IFS= read -r f; do
      case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.zip|*.gz|*.pdf|*.woff*|*.ttf|*.mo|*.lock|*.min.js|*.min.css|*.map|*.svg) continue ;; esac
      n=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
      [ "${n:-0}" -ge "$min" ] && printf '%7d  %s\n' "$n" "$f"
    done | sort -rn
  else
    die "map: $target not found"
  fi
}

# Files Claude Code loads on its own for a session started in $1.
auto_loaded() {
  local d mem="" win slug f
  d=$(cd "$1" && pwd)
  { [ -f "$HOME/.claude/CLAUDE.md" ] && echo "$HOME/.claude/CLAUDE.md"
    while :; do
      for f in CLAUDE.md CLAUDE.local.md .claude/CLAUDE.md; do [ -f "$d/$f" ] && echo "$d/$f"; done
      if [ -z "$mem" ]; then
        win=$(cd "$d" && { pwd -W 2>/dev/null || pwd; })
        slug=$(printf '%s' "$win" | sed 's/[^A-Za-z0-9]/-/g')
        [ -f "$HOME/.claude/projects/$slug/memory/MEMORY.md" ] && mem="$HOME/.claude/projects/$slug/memory/MEMORY.md" && echo "$mem"
      fi
      [ "$d" = / ] || [ "$(dirname "$d")" = "$d" ] && break
      d=$(dirname "$d")
    done; } | while IFS= read -r f; do realpath "$f" 2>/dev/null || echo "$f"; done | awk '!seen[$0]++'
}

cmd_cost() {
  local dir="${1:-.}" sum=0 t f n flags auto
  [ -d "$dir" ] || die "cost: $dir is not a folder"
  auto=$(auto_loaded "$dir")
  echo "AUTO-LOADED every session (paid on every turn; ~tokens = bytes/4):"
  while IFS= read -r f; do [ -n "$f" ] || continue; t=$(tok "$f"); sum=$((sum + t)); printf '  %6d  %s\n' "$t" "$f"; done <<EOF
$auto
EOF
  printf '  %6d  total\n\n' "$sum"
  echo "DOCS (paid when read, then carried for the rest of the session):"
  docs=$(find_files "$dir" -name '*.md' | sort)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n=$(wc -l < "$f" | tr -d ' '); flags=""
    if grep -q '^<!-- toc -->' "$f"; then
      toc_render "$f" | cmp -s - <(tr -d '\r' < "$f") || flags="STALE TOC"
      has=toc
    else
      has=""
      [ "$n" -ge "$TOC_MIN" ] && ! grep -qi '^## *contents' "$f" && flags="NEEDS TOC"
    fi
    case "$(basename "$f" | tr 'A-Z' 'a-z')" in *archive*) ;; *handoff*|*state*) [ "$n" -gt "$HANDOFF_MAX" ] && flags="${flags:+$flags, }STATE FILE OVER $HANDOFF_MAX LINES" ;; esac
    printf '  %6d %5d lines  %-3s  %s%s\n' "$(tok "$f")" "$n" "$has" "${f#"$dir"/}" "${flags:+  <- $flags}"
  done <<EOF
$docs
EOF
  # The same sentence in two files is paid twice and drifts apart. Archives repeat on purpose.
  printf '%s\n%s\n' "$auto" "$docs" | while IFS= read -r f; do [ -n "$f" ] && { realpath "$f" 2>/dev/null || echo "$f"; }; done | awk '!seen[$0]++' | grep -vi archive | while IFS= read -r f; do
    awk -v f="$f" -v note="$NOTE" '{ sub(/\r$/, ""); k = $0; sub(/^[ \t>#*|0-9.-]+/, "", k); k = tolower(k); if (length(k) >= 50 && k != tolower(note)) print f "\t" k }' "$f"
  done | awk -F '\t' '!pair[$0]++ { n[$2]++; where[$2] = where[$2] (n[$2] > 1 ? ", " : "") $1 }
    END { c = 0; for (k in n) if (n[k] > 1) { c++; if (c <= 10) out = out "  \"" substr(k, 1, 90) "\"\n    in " where[k] "\n" }
          printf "\nDUPLICATE LINES across files (keep one home, point to it): %d\n%s", c, out }'
}

cmd_selftest() {
  local tmp f fail=0
  tmp=$(mktemp -d) || die "selftest: no temp dir"
  f="$tmp/doc.md"
  { echo "# T"; echo "intro"; i=0; while [ $i -lt 90 ]; do echo x; i=$((i + 1)); done
    printf '%s\n' '## A' a '### A1' a1 '```' '## not a heading' '```' '## B' b; } > "$f"
  cmd_toc "$f" > /dev/null
  [ "$(grep -c '^ *- [0-9]*-[0-9]*: ' "$f")" = 3 ] || { echo "FAIL toc entry count"; fail=1; }
  grep '^ *- [0-9]*-[0-9]*: ' "$f" | while IFS= read -r e; do
    s=$(echo "$e" | sed 's/^ *- \([0-9]*\)-.*/\1/'); t=$(echo "$e" | sed 's/^ *- [0-9]*-[0-9]*: //')
    sed -n "${s}p" "$f" | grep -qx "##* $t" || echo "FAIL toc entry points off its heading: $e"
  done | grep FAIL && fail=1
  cp "$f" "$tmp/again.md"; cmd_toc "$tmp/again.md" > /dev/null
  cmp -s "$f" "$tmp/again.md" || { echo "FAIL toc second run changed the file"; fail=1; }
  printf '%s\n' '<?php' 'class Foo {' '    public function bar() {' '    }' '    private static function baz() {' '    }' '}' 'function top() {' '}' > "$tmp/a.php"
  out=$(map_file "$tmp/a.php")
  echo "$out" | grep -q '^ *2-7 *class Foo' || { echo "FAIL map class range"; fail=1; }
  echo "$out" | grep -q '^ *3-4 *  public function bar()' || { echo "FAIL map method range"; fail=1; }
  echo "$out" | grep -q '^ *8-9 *function top()' || { echo "FAIL map top-level function"; fail=1; }
  rm -rf "$tmp"
  [ $fail = 0 ] && echo "selftest ok" || { echo "selftest FAILED"; return 1; }
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  map) cmd_map "$@" ;;
  toc) [ $# -gt 0 ] || die "toc: give one or more .md files"; cmd_toc "$@" ;;
  cost) cmd_cost "${1:-.}" ;;
  selftest) cmd_selftest ;;
  *) sed -n '5,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
